# Copy this file to .env and fill in the values you use.
# The application reads .env from the project root. Blank values are ignored.

# Local Ollama. The default host is the Ollama desktop/service port.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional. Raises GitHub API rate limits for star counts and repository search.
GITHUB_TOKEN=

# Daily email at 8:00am IST to this address.
# Gmail requires an app password: https://myaccount.google.com/apppasswords
# Put that 16-character password in SMTP_PASSWORD. A normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=saisoumya.dolly@gmail.com
SMTP_PASSWORD=
SMTP_FROM=saisoumya.dolly@gmail.com
EMAIL_TO=saisoumya.dolly@gmail.com
SMTP_TLS=true
